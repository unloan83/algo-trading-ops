[Unit]
Description=Paper Trading - Intraday Opportunity Scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/algo-trading-core
EnvironmentFile=/home/ubuntu/projects/algo-trading-core/.env
ExecStart=/home/ubuntu/projects/algo-trading-core/.venv/bin/python /home/ubuntu/projects/algo-trading-core/scripts/intraday_scan.py
StandardOutput=journal
StandardError=journal
