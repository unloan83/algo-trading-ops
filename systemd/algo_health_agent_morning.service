[Unit]
Description=Algo Trading - Morning Health Report
After=network-online.target preflight.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/algo-trading-core
EnvironmentFile=/home/ubuntu/projects/algo-trading-core/.env
ExecStart=/home/ubuntu/projects/algo-trading-core/.venv/bin/python /home/ubuntu/projects/algo-trading-core/scripts/algo_health_agent.py --mode morning
StandardOutput=journal
StandardError=journal
