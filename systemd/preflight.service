[Unit]
Description=Paper Trading - Morning Preflight
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/algo-trading-primary-runtime
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/algo-trading-core
EnvironmentFile=/home/ubuntu/projects/algo-trading-core/.env
ExecStart=/home/ubuntu/projects/algo-trading-core/.venv/bin/python /home/ubuntu/projects/algo-trading-core/scripts/preflight.py
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
