[Unit]
Description=Automated Trading System - Lightweight Watchdog Heartbeat
After=network.target

[Service]
Type=oneshot
User=user
ExecStart=/bin/bash -c "curl -s -f http://localhost:8080/health || echo 'VM2 Core Heartbeat Warning' | mail -s 'Trading Watchdog Alert' user@localhost"
StandardOutput=journal

[Install]
WantedBy=multi-user.target
