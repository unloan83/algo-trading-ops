[Unit]
Description=Paper Trading - Position Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/algo-trading-core
EnvironmentFile=/home/ubuntu/projects/algo-trading-core/.env
ExecStart=/home/ubuntu/projects/algo-trading-core/.venv/bin/python /home/ubuntu/projects/algo-trading-core/scripts/paper_monitor.py
StandardOutput=journal
StandardError=journal
