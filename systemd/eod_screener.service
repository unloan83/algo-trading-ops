[Unit]
Description=Paper Trading - EOD Screener
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/algo-trading-primary-runtime

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/algo-trading-core
EnvironmentFile=/home/ubuntu/projects/algo-trading-core/.env
ExecStart=/home/ubuntu/projects/algo-trading-core/.venv/bin/python /home/ubuntu/projects/algo-trading-core/scripts/eod_screener.py
StandardOutput=journal
StandardError=journal
