[Unit]
Description=Offline read-only shadow outcome labeler
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/algo-trading-primary-runtime

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/algo-trading-core
EnvironmentFile=/home/ubuntu/projects/algo-trading-core/.env
ExecStart=/home/ubuntu/projects/algo-trading-core/.venv/bin/python /home/ubuntu/projects/algo-trading-core/scripts/run_shadow_labeler.py --source-db /home/ubuntu/projects/algo-trading-core/trading_system.db --output-db /home/ubuntu/projects/algo-trading-core/learning/shadow_learning.db --timeout-seconds 240
TimeoutStartSec=300
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

